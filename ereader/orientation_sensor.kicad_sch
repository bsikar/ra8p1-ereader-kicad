	(text "MAGNETIC COVER - WIP\nU33 DRV5032FADBZR: FA 20Hz omnipolar push-pull.\nVCC1 +3V3_MCU; GND3; OUT2 COVER_INT_N.\nMCU P412/M12 IRQ20-DS; input pulls disabled.\nC125 220n: local bypass; >=100n effective pending.\nLOW = magnet detected; startup delay pending.\nRetain +3V3_MCU for wake; rail-off wake unavailable.\nMagnet gaps, leakage, power and footprint pending.\nSee design/hall_cover.md; qualification remains open."
		(exclude_from_sim no)
		(at 195.326 48.006 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "73faa323-d40f-4864-b2b2-88d7f476b1a9")
	)
	(text "AMBIENT LIGHT - WIP\nU32 OPT4001DTSR: TI SBOS993A Rev A, 8-pin DTS.\nADDR grounded: 0x44; C124 local 100nF at VDD pin 1.\nR112 10k INT pull-up; firmware keeps INT_DIR=1; polling only.\nShared IIC0_A: R102/R103 3.3k; 25..70pF, +/-17uA planning screen.\nConditional rise 62.912..219.056ns; actual bus and host timing unqualified.\nSee design/ambient_light.md; sealed optical window/light isolation pending."
		(exclude_from_sim no)
		(at 69.596 166.624 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b22856d8-7b84-4c06-8330-e17966d408d7")
	)
	(text "ORIENTATION SENSOR - WIP\nU26: LIS2DTW12TR; ST DS12825 Rev 4 Table 1 pin map.\nVDD pin 9 / VDDIO pin 10: +3V3_MCU; CS / SA0 high for I2C address 0x19.\nC117/C118: local 100n bypass; GND pins 6/8 and RES pin 7 grounded.\nC115: 10u/16V aluminum EEE-FN1C100R; place near VDD pin 9 with C117.\nR102/R103: 3.3k shared SCL/SDA pull-ups; see ALS-005 bus calculation.\nHost connected: SCL P410/K13; SDA P409/R16; INT1 P306/D11.\nST example waits 20ms then polls reset; startup/recovery qualification pending.\nCT qty1 sourcing recorded; pin modes, full timing and passive qualification open.\nSee design/sensor_alternative.md; circuit qualification remains open."
		(exclude_from_sim no)
		(at 42.164 30.734 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b72354b0-64e2-43b5-9b1a-8b42fcd81f19")
	)
